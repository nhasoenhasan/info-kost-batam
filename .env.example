# Salin file ini jadi .env.local lalu isi nilainya.
# .env.local TIDAK ikut di-commit (lihat .gitignore).

# URL CSV export spreadsheet sumber data.
# Contoh bentuk: https://docs.google.com/spreadsheets/d/<ID_SPREADSHEET>/export?format=csv&gid=0
#
# Cara ambil: buka spreadsheet → File → Share → Publish to web → pilih sheet → format CSV,
# atau pakai URL export CSV biasa kalau spreadsheet hanya bisa diakses olehmu.
#
# Nilainya sengaja di luar repo supaya tidak ada orang lain yang mendapat akses ke spreadsheet.
SHEET_CSV_URL=
